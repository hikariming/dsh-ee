# 复制为 .env.local 后填写；.env.local 已被 git 忽略
DSH_EE_DSN='root:@tcp(127.0.0.1:4000)/dsh_ee'
# openssl rand -base64 32
DSH_EE_SECRET_KEY=''
DSH_EE_BOOTSTRAP_ADMIN=admin
DSH_EE_BOOTSTRAP_ADMIN_PASSWORD=''
DSH_EE_ADDR=127.0.0.1:8080
# 扩展签名（docs/plugins.md §9.3）：受信任的签名公钥 PEM 文件（可以放多把）
#DSH_EE_EXTENSION_TRUSTED_KEYS=/etc/dsh-ee/extension-signing-keys.pem
# 设为 1 时没签名或签名无效的扩展不让安装（默认只提示，不阻断）
#DSH_EE_EXTENSION_REQUIRE_SIGNATURE=0
# 内容安全策略：off（默认，只加 frame-ancestors 嵌入收口）/ report（只报告）/ enforce（阻断）
# 上线顺序建议 off → report 观察 → enforce；见 docs/operations.md §10.1
#DSH_EE_CSP=report
# CSP 违规报告地址（可选）；dsh-ee 不自带收集端点
#DSH_EE_CSP_REPORT_URI=https://ee.example.com/api/csp-report
# DeepSeek Chatbot（docs/dev/chatbot.md）：只对 vendor=deepseek 的上游注入；客户端已传时保留。
#DSH_EE_SAFETY_CHECK=high
#DSH_EE_CHAT_TITLE=on

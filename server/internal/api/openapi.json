{
  "openapi": "3.1.0",
  "info": {
    "title": "dsh-ee Harness API",
    "version": "1.0.0",
    "summary": "第三方 Harness 接入 dsh-ee 的中立 v1 契约（只读部分）",
    "description": "dsh-ee 面向第三方 Harness 的中立契约 v1 静态描述。运行时的实际入口、scope、模型与应用以 GET /.well-known/dsh-ee 与 /v1/capabilities 为准；本文件描述这些只读端点的形状、统一错误壳与响应头。MCP（JSON-RPC）与 npm registry 协议不在本文件内。所有 /.well-known/dsh-ee 与 /v1/* 响应都带 Dsh-EE-API-Version: 1。",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "当前 dsh-ee 实例（相对地址，按实际访问地址解析）"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "discovery",
      "description": "公开发现、能力摘要与机器可读契约"
    },
    {
      "name": "models",
      "description": "模型网关：OpenAI chat completions 与 Anthropic Messages 兼容"
    },
    {
      "name": "apps",
      "description": "只读中立微应用"
    }
  ],
  "paths": {
    "/.well-known/dsh-ee": {
      "get": {
        "operationId": "getDiscovery",
        "summary": "公开发现文档（匿名）",
        "tags": [
          "discovery"
        ],
        "description": "返回本实例的入口、鉴权方式、能力与限制。带 ETag 与 Cache-Control: private, max-age=300，支持 If-None-Match 304。文档内的端点地址按请求 Host / X-Forwarded-*（或配置的 PublicURL）生成。",
        "security": [],
        "responses": {
          "200": {
            "description": "发现文档",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlPrivate"
              },
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Discovery"
                }
              }
            }
          },
          "304": {
            "description": "If-None-Match 命中，文档未变化"
          },
          "400": {
            "$ref": "#/components/responses/NeutralError"
          },
          "405": {
            "$ref": "#/components/responses/NeutralError"
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "当前令牌的能力摘要（Bearer 可选）",
        "tags": [
          "discovery"
        ],
        "description": "不带 Authorization 时返回公开子集（authenticated=false，用户数据为空数组）；带令牌时按令牌 scope 与账号权限返回模型、工具计数、微应用、技能摘要与目录 revision。带错令牌返回 401，不会静默降级为匿名。响应 Cache-Control: no-store。",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "能力摘要",
            "headers": {
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestID"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/NeutralError"
          },
          "401": {
            "$ref": "#/components/responses/NeutralError"
          },
          "405": {
            "$ref": "#/components/responses/NeutralError"
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "listModels",
        "summary": "对外模型列表（OpenAI 形状）",
        "tags": [
          "models"
        ],
        "description": "只返回额度与令牌允许的对外模型名；上游厂商模型名不暴露。需要 models scope + 账号 llm.use 权限。",
        "responses": {
          "200": {
            "description": "模型列表",
            "headers": {
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            }
          },
          "401": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          },
          "403": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          },
          "429": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "对话补全（OpenAI chat completions 子集）",
        "tags": [
          "models"
        ],
        "description": "请求体原样转发上游（model 换成上游模型名，流式时补 stream_options.include_usage）；额度、审计、上游故障转移由 dsh-ee 处理。不提供 /v1/embeddings、/v1/responses、/v1/completions。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "对话补全结果；stream=true 时为 text/event-stream",
            "headers": {
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type"
                ],
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
          },
          "401": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",

    "/v1/apps": {
      "get": {
        "operationId": "listApps",
        "summary": "只读中立微应用列表",
        "tags": [
          "apps"
        ],
        "description": "当前用户已启用 / 自动生效的微应用（不含 DSH 专属系统应用）。需要 hub scope + 工作台权限；响应 Cache-Control: no-store。",
        "responses": {
          "200": {
            "description": "微应用列表",
            "headers": {
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestID"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NeutralError"
          },
          "403": {
            "$ref": "#/components/responses/NeutralError"
          }
        }
      }
    },
    "/v1/apps/{name}": {
      "get": {
        "operationId": "getApp",
        "summary": "只读中立微应用描述",
        "tags": [
          "apps"
        ],
        "description": "按应用标识返回中立描述；未对当前用户启用或不存在时 404。需要 hub scope + 工作台权限。",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "微应用标识"
          }
        ],
        "responses": {
          "200": {
            "description": "微应用描述",
            "headers": {
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestID"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NeutralError"
          },
          "403": {
            "$ref": "#/components/responses/NeutralError"
          },
          "404": {
            "$ref": "#/components/responses/NeutralError"
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenAPI",
        "summary": "静态 OpenAPI 3.1 契约（匿名）",
        "tags": [
          "discovery"
        ],
        "description": "本文件：dsh-ee 面向第三方 Harness 的中立 v1 契约静态描述，只读。带 ETag 与 Cache-Control: public, max-age=300，支持 If-None-Match 304。MCP（JSON-RPC）不在本文件内。",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 文档",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlPublic"
              },
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "304": {
            "description": "If-None-Match 命中，契约未变化"
          },
          "400": {
            "$ref": "#/components/responses/NeutralError"
          },
          "405": {
            "$ref": "#/components/responses/NeutralError"
          }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "operationId": "createAnthropicMessage",
        "summary": "Anthropic Messages 兼容（请求转 OpenAI chat；别名 /anthropic/v1/messages）",
        "tags": [
          "models"
        ],
        "description": "Claude Code / Anthropic SDK 兼容入口：用企业令牌（x-api-key 或 Authorization: Bearer）调用 dsh-ee 已接入的模型。请求转成 OpenAI chat completions 后复用 /v1/chat/completions 的模型权限、月度额度、上游故障转移与用量记账；响应与流式 SSE 转回 Anthropic 形状。只实现 POST /v1/messages（及别名 POST /anthropic/v1/messages，行为完全一致）；count_tokens / batches / Files API 返回 404。候选线路第一条（最高优先级）的 provider vendor=deepseek 时走原生透传：请求直接转发到 <provider.base>/anthropic/v1/messages，只改写 model，anthropic-version/anthropic-beta 原样透传，响应 JSON/SSE 逐字节转发，不解析 server tools/citations/safety 等扩展块；其它 vendor 降级成 OpenAI chat 转换（anthropic-version/anthropic-beta 被忽略）。故障转移只在同 vendor/同协议内进行，不跨协议。Files API 本身不实现。错误体是 Anthropic 形状（AnthropicError）。",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "description": "企业令牌；与 Authorization: Bearer 等价，同时带时优先 x-api-key",
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnthropicMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Anthropic message；stream=true 时为 Anthropic SSE 事件流（message_start → content_block_* → message_delta → message_stop）",
            "headers": {
              "Dsh-EE-API-Version": {
                "$ref": "#/components/headers/DshEEAPIVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnthropicMessage"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "请求体不是 JSON、缺 model/max_tokens、参数越界或不支持的内容块（invalid_request_error）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnthropicError"
                }
              }
            }
          },
          "401": {
            "description": "缺少或无效的令牌（authentication_error）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnthropicError"
                }
              }
            }
          },
          "403": {
            "description": "令牌缺 models scope、账号缺 llm.use、模型不在范围或额度过期（permission_error）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnthropicError"
                }
              }
            }
          },
          "404": {
            "description": "对外模型没有可用上游，或 count_tokens 等未实现的兼容端点（not_found_error）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnthropicError"
                }
              }
            }
          },
          "413": {
            "description": "请求体超过 16 MiB（request_too_large）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnthropicError"
                }
              }
            }
          },
          "429": {
            "description": "账号/令牌额度用完、每令牌限流或上游 429（rate_limit_error）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnthropicError"
                }
              }
            }
          },
          "502": {
            "description": "所有上游线路不可用或上游响应无法解析（api_error）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnthropicError"
                }
              }
            }
          }
        }
      }
    },
    "/anthropic/v1/messages": {
      "$ref": "#/paths/~1v1~1messages"
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "ee_at_<token>",
        "description": "员工接入令牌；设备码流程或网页「我的令牌」获取。scope 与账号 RBAC 求交。"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Anthropic 兼容端点也接受 x-api-key: <token>，与 Authorization: Bearer 等价。"
      }
    },
    "headers": {
      "DshEEAPIVersion": {
        "description": "中立 API 主版本，当前恒为 1",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "XRequestID": {
        "description": "请求号；中立端点响应均带，错误体 request_id 与它一致",
        "schema": {
          "type": "string"
        }
      },
      "ETag": {
        "description": "内容摘要，可用于 If-None-Match",
        "schema": {
          "type": "string"
        }
      },
      "CacheControlPrivate": {
        "description": "private, max-age=300",
        "schema": {
          "type": "string"
        }
      },
      "CacheControlPublic": {
        "description": "public, max-age=300",
        "schema": {
          "type": "string"
        }
      },
      "CacheControlNoStore": {
        "description": "no-store",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "NeutralError": {
        "description": "中立统一错误壳（只用于新增中立端点）",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/XRequestID"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "OpenAIError": {
        "description": "/v1 模型网关的 OpenAI 错误壳（形状不变）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/OpenAIError"
            }
          }
        }
      }
    },
    "schemas": {
      "Discovery": {
        "type": "object",
        "required": [
          "name",
          "version",
          "api_version",
          "auth",
          "device_authorization_endpoint",
          "token_endpoint",
          "scopes_supported",
          "models",
          "mcp",
          "apps",
          "chatbot",
          "capabilities_endpoint",
          "openapi_url",
          "limits",
          "errors"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "协议里的服务名，固定为 dsh-ee",
            "examples": [
              "dsh-ee"
            ]
          },
          "version": {
            "type": "string",
            "description": "服务端构建版本（语义化版本或 dev/sha）",
            "examples": [
              "0.2.0"
            ]
          },
          "api_version": {
            "type": "string",
            "description": "中立契约主版本；请求头 Dsh-EE-API-Version 的协商依据",
            "examples": [
              "1"
            ]
          },
          "auth": {
            "$ref": "#/components/schemas/Auth"
          },
          "device_authorization_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "设备码流程：申请设备码（POST，公开）"
          },
          "token_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "设备码流程：轮询领取令牌（POST，公开）"
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "设备码流程可申请的 scope；admin 只能网页限时开启，不在其中"
          },
          "models": {
            "$ref": "#/components/schemas/ModelsDiscovery"
          },
          "mcp": {
            "$ref": "#/components/schemas/McpDiscovery"
          },
          "apps": {
            "$ref": "#/components/schemas/AppsDiscovery"
          },
          "capabilities_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "当前令牌的能力摘要"
          },
          "openapi_url": {
            "type": "string",
            "format": "uri",
            "description": "本静态契约（OpenAPI 3.1）的可读地址"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "errors": {
            "$ref": "#/components/schemas/ErrorsDiscovery"
          },
          "chatbot": {
            "$ref": "#/components/schemas/Chatbot"
          }
        }
      },
      "Auth": {
        "type": "object",
        "required": [
          "type",
          "header",
          "token_types",
          "token_flows"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "bearer"
          },
          "header": {
            "type": "string",
            "description": "请求头格式",
            "examples": [
              "Authorization: Bearer <token>"
            ]
          },
          "token_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "支持的令牌前缀",
            "examples": [
              [
                "ee_at_"
              ]
            ]
          },
          "token_flows": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "device_code",
                "web_manual"
              ]
            },
            "description": "获取令牌的方式：device_code（RFC 8628 子集，员工在浏览器确认）/ web_manual（员工或管理员在网页生成；需要网页会话）"
          }
        }
      },
      "ModelsDiscovery": {
        "type": "object",
        "required": [
          "protocol",
          "streaming",
          "endpoint",
          "chat_completions_endpoint"
        ],
        "properties": {
          "protocol": {
            "type": "string",
            "const": "openai-chat-completions"
          },
          "streaming": {
            "type": "boolean",
            "description": "是否支持 stream=true 的 SSE 流式响应"
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "description": "对外模型列表（OpenAI 形状）"
          },
          "chat_completions_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "对话补全（OpenAI chat completions 子集）"
          },
          "anthropic_messages_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "Anthropic Messages 兼容入口（Claude Code / Anthropic SDK；x-api-key 或 Bearer）"
          },
          "anthropic_messages_aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "同一 handler 的别名入口；DeepSeek 风格的 Anthropic base URL（<base>/anthropic）会拼出 /anthropic/v1/messages"
          },
          "anthropic_messages_native_vendors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "走原生 Anthropic 透传的 provider vendor；这些候选线路直接转发到 <base>/anthropic/v1/messages，响应逐字节转发"
          },
          "anthropic_messages_conversion_fallback": {
            "type": "string",
            "description": "其它 vendor 的降级方式：转成 OpenAI chat completions 后走现有转换层（openai-chat）"
          }
        }
      },
      "McpDiscovery": {
        "type": "object",
        "required": [
          "transport",
          "endpoint",
          "protocol_versions"
        ],
        "properties": {
          "transport": {
            "type": "string",
            "const": "streamable-http"
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "description": "MCP JSON-RPC 端点（Streamable HTTP；JSON-RPC 协议本身不在本 OpenAPI 文件内）"
          },
          "protocol_versions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "支持的 MCP 协议版本，新的在前"
          }
        }
      },
      "AppsDiscovery": {
        "type": "object",
        "required": [
          "web",
          "data_tools",
          "endpoint",
          "web_url"
        ],
        "properties": {
          "web": {
            "type": "boolean",
            "description": "是否有网页版微应用（/a/<slug>）"
          },
          "data_tools": {
            "type": "boolean",
            "description": "MCP 是否提供 app__/data__ 数据工具"
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "description": "只读的微应用描述列表"
          },
          "web_url": {
            "type": "string",
            "format": "uri-template",
            "description": "网页版微应用地址模板，{slug} 换成应用标识"
          }
        }
      },
      "Chatbot": {
        "type": "object",
        "description": "DeepSeek Chatbot 能力的网关侧声明：服务端工具、内容安全、会话标题与拒绝/引用块由上游 DeepSeek 解释；dsh-ee 只注入默认值并原样透传请求与响应，不解析、不改写。",
        "required": [
          "upstream_vendor",
          "passthrough",
          "server_tools",
          "safety_check",
          "title",
          "refusal",
          "response_fields",
          "note"
        ],
        "properties": {
          "upstream_vendor": {
            "type": "string",
            "description": "唯一会注入/解释这些字段的上游类型，固定为 deepseek",
            "examples": [
              "deepseek"
            ]
          },
          "passthrough": {
            "type": "boolean",
            "description": "tools/safety_check/title 与响应里的扩展块原样转发，不解析、不改写"
          },
          "server_tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "tools[].type 里透传给上游的服务端工具；由上游执行，客户端不执行",
            "examples": [
              [
                "deepseek_web_search",
                "deepseek_read_url"
              ]
            ]
          },
          "safety_check": {
            "$ref": "#/components/schemas/ChatbotSafety"
          },
          "title": {
            "$ref": "#/components/schemas/ChatbotTitle"
          },
          "refusal": {
            "type": "boolean",
            "description": "响应里的拒绝标记原样透传（Chat Completions 的 finish_reason=content_filter / message.refusal，Messages 的 stop_reason=refusal）"
          },
          "response_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "原样保留的响应扩展字段/块名（随协议不同，见 docs/dev/chatbot.md）"
          },
          "note": {
            "type": "string",
            "description": "这些能力依赖上游 DeepSeek API 支持；dsh-ee 只透传，不实现服务端工具"
          }
        }
      },
      "ChatbotSafety": {
        "type": "object",
        "description": "内容安全审核参数 safety_check 的透传与注入状态。",
        "required": [
          "supported",
          "injected"
        ],
        "properties": {
          "supported": {
            "type": "boolean",
            "description": "网关原样透传客户端的 safety_check；上游是否支持取决于上游与模型"
          },
          "injected": {
            "type": "boolean",
            "description": "本部署是否在客户端未传时注入 safety_check（DSH_EE_SAFETY_CHECK=high）"
          },
          "level": {
            "type": "string",
            "description": "注入的审核级别，仅在 injected=true 时出现",
            "examples": [
              "high"
            ]
          }
        }
      },
      "ChatbotTitle": {
        "type": "object",
        "description": "会话标题参数 title 的透传与注入状态。",
        "required": [
          "supported",
          "injected"
        ],
        "properties": {
          "supported": {
            "type": "boolean",
            "description": "网关原样透传客户端的 title"
          },
          "injected": {
            "type": "boolean",
            "description": "本部署是否在客户端未传时注入 title（DSH_EE_CHAT_TITLE=on）"
          }
        }
      },
      "Limits": {
        "type": "object",
        "required": [
          "max_request_bytes",
          "max_response_bytes",
          "max_mcp_request_bytes"
        ],
        "properties": {
          "max_request_bytes": {
            "type": "integer",
            "description": "/v1/chat/completions 请求体上限（字节）"
          },
          "max_response_bytes": {
            "type": "integer",
            "description": "/v1/chat/completions 非流式响应体上限（字节）"
          },
          "max_mcp_request_bytes": {
            "type": "integer",
            "description": "/mcp JSON-RPC 请求体上限（字节）"
          }
        }
      },
      "ErrorsDiscovery": {
        "type": "object",
        "required": [
          "format",
          "documentation_url",
          "codes"
        ],
        "properties": {
          "format": {
            "type": "string",
            "description": "统一错误壳形状；/api/* 与 /v1 网关的既有形状保持不变"
          },
          "documentation_url": {
            "type": "string",
            "format": "uri",
            "description": "错误形状与错误码的机器可读文档（本 OpenAPI 文件）"
          },
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "新增中立端点当前会返回的稳定错误码"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "api_version",
          "authenticated",
          "server",
          "user",
          "scopes",
          "models",
          "tools",
          "apps",
          "skills",
          "chatbot",
          "revision"
        ],
        "properties": {
          "api_version": {
            "type": "string"
          },
          "authenticated": {
            "type": "boolean",
            "description": "是否带了有效 Bearer 令牌"
          },
          "server": {
            "$ref": "#/components/schemas/ServerInfo"
          },
          "user": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "令牌的 scope；匿名时为空数组"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "当前令牌允许的对外模型名；顺序与 /v1/models 一致"
          },
          "tools": {
            "type": "object",
            "required": [
              "count"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "description": "与 /mcp tools/list 数量一致；需 connections scope"
              }
            }
          },
          "apps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/App"
            },
            "description": "当前用户已启用 / 自动生效的微应用；需 hub scope"
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillSummary"
            },
            "description": "当前用户可见的技能与提示词摘要（不含正文）；需 hub scope"
          },
          "revision": {
            "type": "string",
            "description": "能力目录 revision；需 hub scope"
          },
          "chatbot": {
            "$ref": "#/components/schemas/Chatbot"
          }
        }
      },
      "SkillSummary": {
        "type": "object",
        "required": [
          "name",
          "title",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "技能 / 提示词标识"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "skill",
              "prompt"
            ]
          }
        }
      },
      "App": {
        "type": "object",
        "required": [
          "name",
          "title",
          "starters",
          "launch",
          "delivery",
          "version",
          "web"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "微应用标识；网页版地址是 /a/<name>"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "starters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "示例问法"
          },
          "launch": {
            "type": "string",
            "description": "在 Harness 里的打开方式（new/resume 等，由 DSH 语义定义）"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "auto",
              "optional"
            ],
            "description": "auto 自动生效；optional 需要员工自己启用"
          },
          "version": {
            "type": "integer"
          },
          "web": {
            "type": "boolean",
            "description": "是否开放网页版 /a/<name>"
          }
        }
      },
      "AppList": {
        "type": "object",
        "required": [
          "api_version",
          "revision",
          "apps"
        ],
        "properties": {
          "api_version": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "apps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/App"
            }
          }
        }
      },
      "AppDetail": {
        "type": "object",
        "required": [
          "api_version",
          "app"
        ],
        "properties": {
          "api_version": {
            "type": "string"
          },
          "app": {
            "$ref": "#/components/schemas/App"
          }
        }
      },
      "Model": {
        "type": "object",
        "required": [
          "id",
          "object",
          "owned_by"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "const": "model"
          },
          "owned_by": {
            "type": "string"
          }
        }
      },
      "ModelList": {
        "type": "object",
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "object": {
            "type": "string",
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          }
        }
      },
      "ChatCompletionRequest": {
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "dsh-ee 的对外模型名（先 GET /v1/models）"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "OpenAI 消息数组"
          },
          "stream": {
            "type": "boolean",
            "description": "true 时返回 text/event-stream"
          }
        },
        "additionalProperties": true,
        "description": "请求体除 model 原样转发上游（上游 vendor=deepseek 且部署开启 DSH_EE_SAFETY_CHECK / DSH_EE_CHAT_TITLE 时，客户端未传的 safety_check / title 会补默认值，已传则保留；非 DeepSeek 上游不注入）；流式时服务端补 stream_options.include_usage；不支持 /v1/embeddings、/v1/responses、/v1/completions。DeepSeek Chatbot 扩展字段见 Chatbot schema 与 docs/dev/chatbot.md。"
      },
      "ChatCompletionResponse": {
        "type": "object",
        "additionalProperties": true,
        "description": "OpenAI chat completions 子集；上游响应体原样返回。"
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "type",
          "code",
          "message"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "错误大类，如 authentication_error / permission_error / invalid_request_error / not_found_error / server_error"
          },
          "code": {
            "type": "string",
            "description": "稳定错误码，取值见 Discovery.errors.codes"
          },
          "message": {
            "type": "string",
            "description": "给人看的说明"
          },
          "request_id": {
            "type": "string",
            "description": "请求号，与响应头 X-Request-Id 一致"
          },
          "retry_after": {
            "type": "integer",
            "description": "建议退避秒数（只在可重试错误上出现）"
          },
          "docs": {
            "type": "string",
            "description": "错误说明链接（可选）"
          },
          "supported_versions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "unsupported_api_version 时给出服务端支持的 API 主版本"
          }
        }
      },
      "OpenAIError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            }
          }
        },
        "description": "/v1 模型网关沿用 OpenAI 错误壳（Dsh-EE-API-Version 响应头仍在）。"
      },
      "ServerInfo": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "required": [
          "username"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "department": {
            "type": "string"
          }
        }
      },
      "AnthropicMessageRequest": {
        "type": "object",
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "dsh-ee 的对外模型名（先 GET /v1/models）；不做 claude-* 名称映射"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32768,
            "description": "必填；单次输出上限与 OpenAI 网关一致"
          },
          "system": {
            "description": "系统提示：字符串或文本块数组",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "Anthropic 消息数组；支持 text / image / tool_use / tool_result / thinking 内容块"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "客户端自定义工具 {name, description?, input_schema}；服务端工具（web_search 等）会被忽略"
          },
          "tool_choice": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ],
            "description": "auto / any / none / tool；any 映射成 OpenAI 的 required"
          },
          "temperature": {
            "type": "number"
          },
          "top_p": {
            "type": "number"
          },
          "stop_sequences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stream": {
            "type": "boolean",
            "description": "true 时返回 Anthropic SSE 事件流"
          },
          "thinking": {
            "type": "object",
            "additionalProperties": true,
            "description": "{type: enabled|disabled|adaptive}；budget_tokens 忽略"
          },
          "reasoning_effort": {
            "type": "string",
            "description": "DeepSeek 风格扩展；也接受 output_config.effort，归一到 OpenAI 的 reasoning_effort"
          },
          "output_config": {
            "type": "object",
            "additionalProperties": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "user_id 映射成 OpenAI 的 user，其余忽略"
          }
        },
        "additionalProperties": true,
        "description": "Anthropic Messages 请求体；dsh-ee 转成 OpenAI chat completions 后转发上游，模型权限、额度与用量记账与 /v1/chat/completions 一致。"
      },
      "AnthropicMessage": {
        "type": "object",
        "required": [
          "id",
          "type",
          "role",
          "model",
          "content",
          "stop_reason",
          "usage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "msg_… 开头的消息 id"
          },
          "type": {
            "type": "string",
            "const": "message"
          },
          "role": {
            "type": "string",
            "const": "assistant"
          },
          "model": {
            "type": "string",
            "description": "客户端请求的对外模型名"
          },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "thinking / text / tool_use 内容块数组"
          },
          "stop_reason": {
            "type": "string",
            "enum": [
              "end_turn",
              "max_tokens",
              "tool_use",
              "refusal"
            ]
          },
          "stop_sequence": {
            "type": [
              "string",
              "null"
            ]
          },
          "usage": {
            "type": "object",
            "required": [
              "input_tokens",
              "output_tokens"
            ],
            "properties": {
              "input_tokens": {
                "type": "integer",
                "description": "prompt_tokens 去掉缓存命中；流式以 message_delta.usage 为准"
              },
              "output_tokens": {
                "type": "integer"
              },
              "cache_creation_input_tokens": {
                "type": "integer"
              },
              "cache_read_input_tokens": {
                "type": "integer",
                "description": "上游 prompt_tokens_details.cached_tokens"
              }
            }
          }
        },
        "additionalProperties": true
      },
      "AnthropicError": {
        "type": "object",
        "required": [
          "type",
          "error"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "error"
          },
          "error": {
            "type": "object",
            "required": [
              "type",
              "message"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "按 HTTP 状态码映射：401 authentication_error、403 permission_error、404 not_found_error、429 rate_limit_error、413 request_too_large、5xx api_error/overloaded_error，其余 4xx invalid_request_error"
              },
              "message": {
                "type": "string",
                "description": "给人看的说明"
              }
            }
          }
        }
      }
    }
  }
}
